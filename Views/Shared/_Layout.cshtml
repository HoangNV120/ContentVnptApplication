
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f5f6fa;
            margin: 0;
        }

        /* HEADER */
        .main-header {
            background: #0d3b66;
            padding: 12px 0;
            position: relative;
        }

        .nav-center {
            display: flex;
            justify-content: center;
            gap: 30px;
            font-weight: 600;
        }

            .nav-center a {
                text-decoration: none;
                color: #ffffff;
                transition: 0.2s;
            }

                .nav-center a:hover {
                    color: #ffd166;
                }

        /* dropdown */
        .dropdown-menu {
            min-width: 200px;
        }

        .dropdown-item:hover {
            background: #f1f1f1;
        }

        .dropdown-menu .dropdown-item {
            color: #333 !important;
        }

            .dropdown-menu .dropdown-item:hover {
                background: #f1f1f1;
                color: #000 !important;
            }

        /* right */
        .right-box {
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
        }

        .user-name {
            color: #fff;
            font-weight: 500;
        }

        /* CONTENT */
        .main-content {
            min-height: 80vh;
            padding: 20px;
        }

        /* FOOTER */
        .footer {
            background: #fff;
            border-top: 1px solid #eee;
            padding: 15px;
            text-align: center;
            font-size: 14px;
            color: #777;
        }

        body {
            padding-top: 0;
        }

        @@media (max-width: 768px) {
            .ticker-wrapper {
                height: 38px;
                font-size: 13px;
            }

            .ticker-item {
                margin-right: 25px;
            }
        }

        #backToTopBtn {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 45px;
            height: 45px;
            border: none;
            border-radius: 50%;
            background: #0d3b66;
            color: white;
            font-size: 20px;
            font-weight: bold;
            display: none;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 9999;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

            #backToTopBtn:hover {
                background: #ffd166;
                color: black;
            }

    </style>
</head>
<body>
    @Html.Action("LatestBanner", "Banner")
    <!-- HEADER -->
    <nav class="navbar navbar-expand-lg navbar-dark shadow-sm"
         style="background:#0d3b66;">

        <div class="container-fluid">

            <a class="navbar-brand fw-bold me-4" href="/">
                Trang của tôi
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNav">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">

                <div class="nav-scroll mx-auto">

                    <ul class="navbar-nav align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link text-white px-3" href="/">
                                Trang chủ
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white px-3"
                               data-bs-toggle="dropdown">

                                Danh mục
                            </a>

                            <ul class="dropdown-menu">

                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cate in ViewBag.Categories)
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               href="/category/@cate.Slug">

                                                @cate.Title
                                            </a>
                                        </li>
                                    }
                                }

                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white px-3" href="#">
                                Bài viết
                            </a>
                        </li>

                        @if (Request.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning px-3"
                                   href="/Admin/AdminUser">

                                    Quản lý
                                </a>
                            </li>
                        }

                    </ul>
                </div>

                <div class="user-box ms-lg-3">

                    @Html.Partial("_LoginPartial")

                </div>

            </div>
        </div>
    </nav>
    @Html.Action("LatestPostsTicker", "Home")

    <!-- CONTENT -->
    <div class="container main-content">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <div class="footer">
        © @DateTime.Now.Year - My Blog
    </div>

    <div class="position-fixed top-0 end-0 p-3" style="z-index:9999">
        <div id="toastBox" class="toast align-items-center text-bg-success border-0">
            <div class="d-flex">
                <div class="toast-body" id="toastMessage">
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <button id="backToTopBtn" onclick="scrollToTop()">
        ↑
    </button>

    <script>
        window.onscroll = function () {
            var btn = document.getElementById("backToTopBtn");

            if (document.body.scrollTop > 200 || document.documentElement.scrollTop > 200) {
                btn.style.display = "flex";
            } else {
                btn.style.display = "none";
            }
        };

        function scrollToTop() {
            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });
        }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var message = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["Success"]));

        if (message && message !== "") {
            var toastEl = document.getElementById('toastBox');
            document.getElementById("toastMessage").innerText = message;

            var toast = new bootstrap.Toast(toastEl);
            toast.show();
        }
    });
    </script>
</body>
</html>
@model List<ContentVnptApplication.Models.Post>

<style>

    .news-ticker-wrapper {
        background: #111;
        color: white;
        overflow: hidden;
        position: sticky;
        top: 0;
        z-index: 999;
        height: 48px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid #222;
    }

    .news-label {
        background: #dc3545;
        padding: 0 18px;
        height: 100%;
        display: flex;
        align-items: center;
        font-weight: 700;
        flex-shrink: 0;
        z-index: 2;
        font-size: 14px;
    }

    .news-ticker-container {
        flex: 1;
        overflow: hidden;
        position: relative;
        height: 100%;
        display: flex;
        align-items: center;
    }

    .news-ticker-track {
        display: flex;
        width: max-content;
        animation: tickerMove 22s linear infinite;
    }

    .news-ticker-wrapper:hover .news-ticker-track {
        animation-play-state: paused;
    }

    .news-ticker-group {
        display: flex;
        align-items: center;
    }

    .news-ticker-item {
        color: white;
        text-decoration: none;
        margin-right: 90px;
        white-space: nowrap;
        font-size: 15px;
        transition: 0.2s;
    }

        .news-ticker-item:hover {
            color: #ffc107;
        }

    @@keyframes tickerMove {

        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(-50%);
        }
    }

    @@media (max-width: 768px) {

        .news-ticker-wrapper {
            height: 42px;
        }

        .news-label {
            font-size: 12px;
            padding: 0 12px;
        }

        .news-ticker-item {
            font-size: 13px;
            margin-right: 35px;
        }

        .news-ticker-track {
            animation-duration: 22s;
        }
    }
</style>

<div class="news-ticker-wrapper">

    <div class="news-label">
        Tin mới
    </div>

    <div class="news-ticker-container">

        <div class="news-ticker-track">

            <div class="news-ticker-group">

                @foreach (var item in Model)
                {
                    <a class="news-ticker-item"
                       href="/post/@item.Slug">

                        @item.Title

                    </a>
                }

            </div>

            <div class="news-ticker-group">

                @foreach (var item in Model)
                {
                    <a class="news-ticker-item"
                       href="/post/@item.Slug">

                        @item.Title

                    </a>
                }

            </div>

        </div>

    </div>

</div>
@{
    Layout = null;
    ViewBag.Title = "Đổi mật khẩu thành công";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Đổi mật khẩu thành công</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background: linear-gradient(135deg, #0d3b66, #145da0);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .success-card {
            width: 100%;
            max-width: 450px;
            border-radius: 15px;
            padding: 35px;
            background: #fff;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .icon {
            font-size: 60px;
            margin-bottom: 15px;
        }

        .title {
            font-weight: 700;
            color: #0d3b66;
            margin-bottom: 10px;
        }

        .desc {
            color: #666;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .btn-login {
            border-radius: 10px;
            padding: 10px 20px;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="success-card">

        <div class="icon">
            ✅
        </div>

        <h3 class="title">Đổi mật khẩu thành công</h3>

        <div class="desc">
            Mật khẩu của bạn đã được cập nhật thành công.
            Bây giờ bạn có thể đăng nhập lại bằng mật khẩu mới.
        </div>

        <a href="/Account/Login" class="btn btn-primary btn-login">
            Đăng nhập ngay
        </a>

    </div>

</body>
</html>
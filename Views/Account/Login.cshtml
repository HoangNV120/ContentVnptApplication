@using ContentVnptApplication.Models
@model LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background: linear-gradient(135deg, #0d3b66, #145da0);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            border-radius: 15px;
            padding: 30px;
            background: #fff;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .login-title {
            font-weight: 700;
            text-align: center;
            margin-bottom: 20px;
            color: #0d3b66;
        }

        .form-control {
            border-radius: 10px;
        }

        .btn-login {
            width: 100%;
            border-radius: 10px;
            padding: 10px;
            font-weight: 600;
        }

        .small-link {
            text-align: center;
            margin-top: 10px;
        }

            .small-link a {
                text-decoration: none;
            }
    </style>
</head>

<body>

    <div class="login-card">

        <h3 class="login-title">Đăng nhập</h3>

        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Email" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Password" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-primary btn-login">
                Đăng nhập
            </button>
        }

        <div class="text-end mt-2">
            <a href="/Account/ForgotPassword"
               class="text-decoration-none text-primary small">
                Quên mật khẩu?
            </a>
        </div>

        <div class="small-link">
            @Html.ActionLink("Tạo tài khoản mới", "Register", "Account", new { @class = "text-primary" })
        </div>

        <div class="small-link mt-2">
            <a href="/" class="text-primary">
                ← Quay về trang chủ
            </a>
        </div>

    </div>
    <div class="position-fixed top-0 end-0 p-3" style="z-index:9999">
        <div id="toastBox" class="toast align-items-center text-bg-success border-0">
            <div class="d-flex">
                <div class="toast-body" id="toastMessage">
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>
    <script>
    document.addEventListener("DOMContentLoaded", function () {

        var message = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["Success"]));

        if (message) {
            var toastEl = document.getElementById('toastBox');
            document.getElementById("toastMessage").innerText = message;
    
            var toast = new bootstrap.Toast(toastEl, {
                delay: 3000
            });

            toast.show();
        }
    });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
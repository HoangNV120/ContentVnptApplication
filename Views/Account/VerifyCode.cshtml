@model ContentVnptApplication.Models.VerifyCodeViewModel

@{
    Layout = null;
    ViewBag.Title = "Xác thực mã";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    @Styles.Render("~/Content/css")
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background: linear-gradient(135deg, #0d3b66, #145da0);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card-auth {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .title {
            font-weight: 700;
            text-align: center;
            margin-bottom: 20px;
            color: #0d3b66;
        }

        .form-control {
            border-radius: 10px;
        }
    </style>
</head>

<body>

    <div class="card-auth">

        <h3 class="title">Nhập mã xác thực</h3>

        @using (Html.BeginForm("VerifyCode", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.Hidden("provider", Model.Provider)
            @Html.Hidden("rememberMe", Model.RememberMe)

            @Html.ValidationSummary("", new { @class = "text-danger" })

            <div class="mb-3">
                <label class="form-label">Mã xác thực</label>
                @Html.TextBoxFor(m => m.Code, new { @class = "form-control", placeholder = "Nhập mã gửi về email/phone" })
            </div>

            <div class="form-check mb-3">
                @Html.CheckBoxFor(m => m.RememberBrowser, new { @class = "form-check-input" })
                <label class="form-check-label">Ghi nhớ thiết bị</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Xác nhận
            </button>
        }

    </div>

</body>
</html>
@{
    Layout = null;
    ViewBag.Title = "Xác nhận email";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    @Styles.Render("~/Content/css")
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background: linear-gradient(135deg, #0d3b66, #145da0);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .card-auth {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .title {
            font-weight: 700;
            color: #0d3b66;
            margin-bottom: 15px;
        }
    </style>
</head>

<body>

    <div class="card-auth">

        <h3 class="title">Xác nhận email thành công 🎉</h3>

        <p>Bạn đã xác nhận tài khoản thành công.</p>

        <a href="/Account/Login" class="btn btn-primary w-100 mt-3">
            Đăng nhập ngay
        </a>

    </div>

</body>
</html>
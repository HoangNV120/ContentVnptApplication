@model ContentVnptApplication.Models.Post
@{
    var related = ViewBag.RelatedPosts as List<ContentVnptApplication.ViewModel.PostViewModel>;
    ViewBag.Title = Model.Title;
}

<style>
    .related-item {
        border-radius: 10px;
        transition: 0.25s;
        cursor: pointer;
    }

        .related-item:hover {
            background: #f5f7fa;
            transform: translateY(-2px);
        }

    .related-title {
        font-size: 14px;
        font-weight: 600;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .related-desc {
        font-size: 13px;
        color: #666;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .sticky-sidebar {
        position: sticky;
        top: 20px;
    }
</style>

<div class="container mt-4">
    <div class="row">

        <div class="col-md-8">

            <h2>@Model.Title</h2>

            <div class="text-muted mb-2">
                @Model.CreatedAt.ToString("dd/MM/yyyy") |
                @(Model.Author ?? "Admin") |
                @(Model.PostCategory?.Title ?? "Chưa phân loại")
            </div>

            <div style="font-size:15px; font-weight:500; color:#444; margin-bottom:15px;">
                @Model.PostBrief
            </div>

            <img src="@(Model.ImageUrl ?? "/images/default.png")"
                 style="width:100%; max-height:400px; object-fit:cover; border-radius:10px;" />

            <div class="mt-4">
                @Html.Raw(Model.Description)
            </div>

            @if (ViewBag.RelatedPosts != null)
            {
                var others = ViewBag.RelatedPosts as List<ContentVnptApplication.ViewModel.PostViewModel>;

                if (others.Any())
                {
                    <div class="mt-5">

                        <h5 class="mb-3">Bài viết khác</h5>

                        <div class="list-group">

                            @foreach (var item in others)
                            {
                                <a href="/post/@item.Slug"
                                   class="list-group-item list-group-item-action"
                                   style="border: none; border-bottom: 1px solid #eee;">

                                    <div style="font-weight:600; font-size:15px; color:#000;">
                                        @item.Title
                                    </div>

                                </a>
                            }

                        </div>

                    </div>
                }
            }

        </div>

        <div class="col-md-4">
            <div class="sticky-sidebar">

                <h5 class="mb-3">Bài viết liên quan</h5>

                @if (related != null && related.Any())
                {
                    foreach (var item in related)
                    {
                        <a href="/post/@item.Slug"
                           style="text-decoration:none; color:black;">

                            <div class="related-item d-flex p-2 mb-3">

                                <img src="@(item.ImageUrl ?? "/images/default.png")"
                                     style="width:90px;height:70px;object-fit:cover;border-radius:8px;" />

                                <div class="ms-2">

                                    <span class="badge bg-primary mb-1">
                                        @(item.PostCategoryTitle ?? "Khác")
                                    </span>

                                    <div class="related-title">
                                        @item.Title
                                    </div>

                                    <div class="related-desc">
                                        @{
                                            var brief = item.PostBrief ?? "";

                                            if (brief.Length > 80)
                                            {
                                                @brief.Substring(0, 80)<text>...</text>
                                            }
                                            else
                                            {
                                                @brief
                                            }
                                        }
                                    </div>

                                    <div style="font-size:11px; color:gray;">
                                        @item.Created.ToString("dd/MM/yyyy")
                                    </div>

                                </div>

                            </div>
                        </a>
                    }
                }
                else
                {
                    <p class="text-muted">Không có bài liên quan</p>
                }

            </div>
        </div>

    </div>
</div>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            margin: 0;
        }

        .sidebar {
            width: 230px;
            height: 100vh;
            background: #1e293b;
            color: white;
            position: fixed;
        }

            .sidebar a {
                color: #cbd5f5;
                display: block;
                padding: 12px 16px;
                text-decoration: none;
            }

                .sidebar a:hover {
                    background: #334155;
                    color: white;
                }

        .content {
            margin-left: 230px;
            padding: 20px;
            background: #f1f5f9;
            min-height: 100vh;
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <h4 class="p-3">Admin</h4>
        <a href="/">Về trang chủ</a>
        <a href="/Admin/AdminUser">Người dùng</a>
        <a href="/Admin/AdminPost">Bài viết</a>
        <a href="/Admin/AdminPostCategory">Danh mục bài viết</a>
        <a href="/Admin/AdminBanner">Banner</a>
    </div>

    <div class="content">
        @RenderBody()
    </div>


    <div class="position-fixed top-0 end-0 p-3" style="z-index:9999">
        <div id="toastBox" class="toast align-items-center text-bg-success border-0">
            <div class="d-flex">
                <div class="toast-body" id="toastMessage">
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    document.addEventListener("DOMContentLoaded", function () {
        var message = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["Success"]));

        if (message && message !== "") {
            var toastEl = document.getElementById('toastBox');
            document.getElementById("toastMessage").innerText = message;

            var toast = new bootstrap.Toast(toastEl);
            toast.show();
        }
    });
    </script>
</body>
</html>